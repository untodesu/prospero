[Unit]
Description=Prospero Server Instance %i
After=network.target
Wants=network.target

[Service]
Type=simple
User=nobody
Group=nogroup

ConfigurationDirectory=prospero/%i
RuntimeDirectory=prospero/%i
StateDirectory=prospero/%i

ExecStart=${INSTALL_BINDIR}/prospero-server /etc/prospero/%i
WorkingDirectory=/var/lib/prospero/%i

Restart=on-failure
RestartSec=5s

ProtectSystem=full
ReadWritePaths=/etc/prospero/%i
ProtectHome=yes

[Install]
WantedBy=multi-user.target
