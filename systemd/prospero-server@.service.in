[Unit]
Description=Prospero Server Instance %i
After=network.target
Wants=network.target

[Service]
Type=simple
User=nobody
Group=nogroup

ExecStartPre=+/usr/bin/mkdir -p ${INSTALL_SYSCONFDIR}/prospero/%i
ExecStartPre=+/usr/bin/mkdir -p ${INSTALL_SYSCONFDIR}/prospero/%i
ExecStartPre=+/usr/bin/chown nobody:nogroup ${INSTALL_SYSCONFDIR}/prospero/%i
ExecStartPre=+/usr/bin/chown nobody:nogroup ${INSTALL_SYSCONFDIR}/prospero/%i

ExecStart=${INSTALL_BINDIR}/prospero-server ${INSTALL_SYSCONFDIR}/prospero/%i
WorkingDirectory=/var/lib/prospero/%i

Restart=on-failure
RestartSec=5s

ProtectSystem=full
ReadWritePaths=${INSTALL_SYSCONFDIR}/prospero/%i
ProtectHome=yes

[Install]
WantedBy=multi-user.target
